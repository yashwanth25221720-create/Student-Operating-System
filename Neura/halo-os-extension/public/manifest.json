{
  "manifest_version": 3,
  "name": "Halo OS",
  "description": "A productivity operating system for Chrome's New Tab page.",
  "version": "0.1.0",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["bookmarks", "storage", "tabs", "tabGroups"],
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Halo OS"
  },
  "host_permissions": ["<all_urls>"]
}
